# Buy-iT web (PWA) en el VPS.
#  - Sirve la app (carpeta dist).
#  - /api/*        -> backend de Vercel (asi la direccion que ve el usuario es la nuestra)
#  - /fotos/subir  -> servicio de fotos del VPS (contenedor buyit-imagenes, misma red de Traefik)
# Traefik entrega el HTTPS; este contenedor escucha en el puerto 8080 sin publicarlo.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # DNS interno de Docker (resuelve tambien nombres de internet). Con variables, nginx
    # no se cae al arrancar si el otro contenedor todavia no esta arriba.
    resolver 127.0.0.11 valid=60s ipv6=off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(self), camera=(self)" always;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    location /api/ {
        set $backend ${BUYIT_BACKEND_HOST};
        proxy_pass https://$backend;
        proxy_set_header Host $backend;
        proxy_ssl_server_name on;
        proxy_ssl_name $backend;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
        add_header Cache-Control "no-store" always;
    }

    location = /fotos/subir {
        set $fotos ${BUYIT_FOTOS_INTERNO};
        proxy_pass http://$fotos/subir;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        client_max_body_size 8m;
        proxy_read_timeout 90s;
    }

    # El service worker y la pagina principal nunca se cachean: asi cada version nueva llega sola.
    location = /sw.js { add_header Cache-Control "no-cache" always; try_files $uri =404; }
    location = /index.html { add_header Cache-Control "no-cache" always; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache" always; default_type application/manifest+json; }

    # Archivos con huella en el nombre: se pueden guardar un año.
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable" always; try_files $uri =404; }

    # App de una sola pagina: cualquier ruta (/compras, /viajes...) sirve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
